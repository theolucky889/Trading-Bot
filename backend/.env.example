# Trading Bot backend configuration.
# Copy this file to backend/.env and fill in real values. Do NOT commit .env.

# ── FastAPI backend (backend/app.py) ─────────────────────────────────
# Handles analysis, backtest, sentiment AND auth (register / login / session
# + per-user sentiment history) via backend/auth.py + SQLite.

# Secret used to sign/verify JWTs (HS256). If unset, the FastAPI backend
# generates a random EPHEMERAL secret at startup — tokens then invalidate on
# every restart. Set a long, random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Optional. Override the auth SQLite database path
# (default: backend/data/trading_bot.db). Used mainly by tests.
AUTH_DB_PATH=

# Optional. Login rate limiting (brute-force mitigation on /api/login).
# In-memory, per process, per IP.
# Window length in milliseconds (default: 900000 = 15 minutes).
LOGIN_RATE_WINDOW_MS=900000
# Max login attempts per IP per window (default: 10).
LOGIN_RATE_MAX=10

# Optional. Comma-separated list of allowed CORS origins (exact match).
# Defaults to the Vite dev server. Do NOT use "*" with credentials.
CORS_ORIGINS=http://localhost:5173

# ── LEGACY: Express + MongoDB auth server (backend/server.js) ─────────
# Only needed if you run the optional legacy auth server. It is no longer
# wired to the Vite dev proxy; auth runs on the FastAPI backend above.
# JWT_SECRET (above) is also required by server.js when used.
# Optional. Port the legacy auth server listens on (default: 3000).
PORT=3000
# Optional. MongoDB connection string (legacy only).
MONGODB_URI=mongodb://localhost:27017/trading-bot
